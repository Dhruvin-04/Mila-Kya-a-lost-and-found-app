rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users — anyone authenticated can read, only owner can write
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Items — authenticated users can read and create, only reporter can update/delete
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.reportedBy == request.auth.uid;
    }

    // Keepers — read-only for authenticated users
    match /keepers/{keeperId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Chats — only participants can read/write
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
